TEAM_ID=

PRODUCT_NAME=Thykra
PRODUCT_BUNDLE_IDENTIFIER=com.jameeli.thykra.Thykra$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Where this build talks to. Leave both empty for a simulator build against a server
// on the same machine — the app falls back to localhost. A device or TestFlight build
// MUST set them, because on a phone localhost is the phone.
//
// Example:
//   THYKRA_API_BASE_URL=https:/$()/api.thykra.com
//   THYKRA_WEB_BASE_URL=https:/$()/thykra.com
//
// The $() in the middle is not a typo: xcconfig treats // as a comment even inside a
// value, and $() breaks the pair without changing the result.
THYKRA_API_BASE_URL=
THYKRA_WEB_BASE_URL=
