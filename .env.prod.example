# Copy this file to .env.prod and fill in real values.
# .env.prod is gitignored — NEVER commit secrets.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build

# --- Database ---
DATABASE_NAME=thykra
DATABASE_USER=thykra
DATABASE_PASSWORD=change-me-please

# --- Storage (LocalStack defaults; override for real AWS) ---
S3_BUCKET=thykra-media
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
# Public URL the web client will use to fetch objects. For the local stack this
# defaults to http://localhost:4566/<bucket>. For real AWS use the CDN/CloudFront URL.
S3_PUBLIC_BASE_URL=http://localhost:4566/thykra-media

# --- JWT signing secret ---
# Generate a long random value: openssl rand -hex 64
JWT_SECRET=replace-me-with-openssl-rand-hex-64

# --- OAuth ---
# Real Google OAuth client id (web application type). Required for sign-in.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- E2E test backdoor ---
# Set to true ONLY for CI / Playwright runs. NEVER in production.
ALLOW_DEV_LOGIN=false

# --- Host-side server port ---
SERVER_PORT=8081
