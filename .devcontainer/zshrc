# ~/.zshrc — Thykra devcontainer
# Minimal, dev-ready zsh: autosuggestions, syntax highlighting, fzf, git-aware prompt.

# ---- History ---------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS \
       APPEND_HISTORY INC_APPEND_HISTORY EXTENDED_HISTORY

# ---- Options ---------------------------------------------------------------
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt INTERACTIVE_COMMENTS NO_BEEP
setopt PROMPT_SUBST

# ---- Completion ------------------------------------------------------------
fpath=(~/.zsh/zsh-completions/src $fpath)
autoload -Uz compinit && compinit -u

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:descriptions' format '%F{cyan}%d%f'
zstyle ':completion:*:warnings' format '%F{red}no matches found%f'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose yes

# ---- Plugins ---------------------------------------------------------------
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

# fzf keybindings: Ctrl-R history, Ctrl-T file, Alt-C dir
[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[ -f /usr/share/doc/fzf/examples/completion.zsh ]   && source /usr/share/doc/fzf/examples/completion.zsh

# Syntax highlighting must be sourced LAST.
source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null

# ---- Prompt: minimal, two-line, git-aware ----------------------------------
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %F{magenta}%b%f'
zstyle ':vcs_info:git:*' actionformats ' %F{magenta}%b%f %F{red}(%a)%f'
precmd() { vcs_info }

PROMPT='%F{cyan}%~%f${vcs_info_msg_0_}
%F{green}❯%f '
RPROMPT='%(?..%F{red}✗ %?%f)'

# ---- Aliases ---------------------------------------------------------------
alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias la='ls -A --color=auto'
alias grep='grep --color=auto'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias gco='git checkout'
alias gb='git branch'
command -v batcat >/dev/null && alias cat='batcat --paging=never --style=plain'

# ---- Tooling paths ---------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"
export ANDROID_HOME="${ANDROID_HOME:-/opt/android-sdk}"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH"

# ---- Welcome ---------------------------------------------------------------
# Ensure cd lands on workspace for new shells.
[ -d /workspace ] && [ "$PWD" = "$HOME" ] && cd /workspace
