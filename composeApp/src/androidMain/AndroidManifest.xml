<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        An upload batch has to survive the app being backgrounded; without a foreground
        service Android is free to freeze the process mid-batch. dataSync is the type that
        describes "finishing a transfer the user asked for".

        POST_NOTIFICATIONS is runtime-granted from API 33. Denied, the service still runs
        and the batch still finishes — only the progress notification is suppressed — so
        the app does not block an upload on it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                App Links. autoVerify makes a tapped thykra.com link open the app
                directly rather than through a disambiguation sheet, which is the whole
                point of the invite loop: a link in a group chat has to land in the trip,
                not in a browser. Verification needs assetlinks.json served from
                https://thykra.com/.well-known/ with this app's signing fingerprint.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="thykra.com" android:pathPrefix="/trips" />
                <data android:scheme="https" android:host="thykra.com" android:pathPrefix="/invite" />
                <data android:scheme="https" android:host="thykra.com" android:pathPrefix="/r" />
            </intent-filter>

            <!--
                Share-to-Thykra. A photo shared from the gallery lands here, and the app
                asks which trip it belongs to.

                mimeType is image/* and video/* rather than */*: appearing in the share
                sheet for a PDF and then refusing it is worse than not appearing at all.
                SEND carries one item in EXTRA_STREAM, SEND_MULTIPLE a list, and both are
                delivered to the existing singleTop activity through onNewIntent.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- The custom scheme the widgets already emit. No verification needed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="thykra" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.jameeli.thykra.widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name="com.jameeli.thykra.api.UploadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name="com.jameeli.thykra.widget.LatestPhotoWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/latest_photo_widget_info" />
        </receiver>

        <receiver
            android:name="com.jameeli.thykra.widget.RecentActivityWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_activity_widget_info" />
        </receiver>
    </application>

</manifest>
