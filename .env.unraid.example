# Copy to .env.unraid and fill in real values. .env.unraid is gitignored.
#
#   cp .env.unraid.example .env.unraid
#   docker compose -f docker-compose.unraid.yml --env-file .env.unraid up -d --build

# --- Unraid host ---
# LAN hostname clients use to reach this server. Must match the Google OAuth
# authorized JavaScript origin.
PUBLIC_HOST=tower.local
# The same machine's LAN IP. Containers cannot resolve mDNS (.local) names, so
# this is injected into the server container's /etc/hosts for PUBLIC_HOST.
UNRAID_HOST_IP=192.168.1.5
# Where persistent data lives on the array.
APPDATA_ROOT=/mnt/user/appdata/thykra

# --- Published ports ---
# WEB_PORT must never be 80: the Unraid WebGUI owns host port 80. 8080 is
# commonly taken as well (StirlingPDF on this host), hence 8088.
WEB_PORT=8088
SERVER_PORT=8081
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Database ---
DATABASE_NAME=thykra
DATABASE_USER=thykra
# Generate: openssl rand -hex 24
DATABASE_PASSWORD=change-me-please

# --- Storage (MinIO) ---
S3_BUCKET=thykra-media
S3_REGION=us-east-1
# These are the MinIO root credentials as well as the server's S3 credentials.
# Generate the secret: openssl rand -hex 24  (must be at least 8 characters)
S3_ACCESS_KEY=thykra-minio-admin
S3_SECRET_KEY=change-me-please
# Origin allowed to PUT directly to MinIO from the browser. "*" is fine on a
# trusted LAN; once the app is exposed publicly, list the real origins instead
# (comma-separated) — e.g. https://thykra.example.com,http://tower.local:8088.
MINIO_CORS_ALLOW_ORIGIN=*

# --- JWT signing secret ---
# Generate: openssl rand -hex 64
JWT_SECRET=replace-me-with-openssl-rand-hex-64

# --- OAuth ---
# Google OAuth client id (Web application type). Baked into the web bundle at
# build time and used by the server to verify ID tokens. Every URL the web app
# is reached by must be listed as an authorized JavaScript origin on this
# client — the LAN one (http://tower.local:8088) and any public hostname you
# put in front of it.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- CORS ---
# Comma-separated origins allowed to call the API cross-origin. Normally empty:
# nginx serves the SPA and proxies /api under one origin, so the browser's
# requests are same-origin and never reach this list. Only set it if you serve
# a client from some other host.
# CORS_ALLOWED_ORIGINS=https://someother.example.com

# --- Cloudflare tunnel (Thykra only) ---
# Connector token from Zero Trust > Networks > Tunnels > Configure — the long
# string in the install command, not the tunnel id. The stack refuses to start
# without it. Keep this tunnel separate from any other on the same host so the
# two can be routed, restarted and revoked independently.
CLOUDFLARE_TUNNEL_TOKEN=change-me-please

# Public origin for MinIO. The SigV4 presigner signs the Host header, so this
# is the exact origin browsers and phones must fetch from — it cannot be
# rewritten downstream without invalidating the signature.
#   through the tunnel: https://thykra-s3.example.com   (no port; 443)
#   LAN only:           http://tower.local:9000
# The server also uses this endpoint for its own reads, writes and deletes, so
# with a tunnel value that traffic leaves the host and comes back in.
S3_PUBLIC_ENDPOINT=http://tower.local:9000
